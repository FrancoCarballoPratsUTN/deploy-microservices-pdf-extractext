# Variables del despliegue unificado (deploy/). Copiar a ".env" y completar.
# Ningún valor real de token debe commitearse (certs/*.pem y .env están en .gitignore).
#
# Bootstrap-only: dirección/CA/tokens de Consul y parámetros de infraestructura.
# CONSUL_ENABLED es una variable de entorno del proceso fijada a "true" en los
# servicios por compose.yaml; NO va aquí ni en Consul KV.
# La configuración funcional vive en Consul KV (deploy/kv/*, cargada por make kv-seed).

# ---- Consul (control plane en red privada backend) ----
# Consul corre con container_name=consul. Su UI/API se publica sólo en loopback
# (127.0.0.1:8501); el resto del acceso del host y los scripts usan `docker exec`.
CONSUL_CONTAINER=consul
CONSUL_HTTP_ADDR=https://consul:8501
CONSUL_CATALOG_ADDRESS=consul:8501
CONSUL_CATALOG_SCHEME=https
# Ruta en el HOST al CA de Consul (montado en Traefik y servicios).
CONSUL_CA_FILE=/absolute/path/to/consul-ca.pem
CONSUL_LOCAL_CA=/consul/config/tls/consul-ca.pem
CONSUL_LOCAL_URL=https://127.0.0.1:8501

# Tokens ACL (reemplazar con valores reales).
CONSUL_TRAEFIK_TOKEN=replace-with-read-only-catalog-token
CONSUL_ORCHESTRATOR_TOKEN=replace-with-orchestrator-token
CONSUL_EXTRACT_TOKEN=replace-with-extract-token
CONSUL_PERSISTENCE_TOKEN=replace-with-persistence-token
CONSUL_AUDIT_TOKEN=replace-with-audit-token

# Prefijos KV.
CONSUL_ORCHESTRATOR_KV_PREFIX=pdf-extractext/dev/orchestrator
CONSUL_EXTRACT_KV_PREFIX=pdf-extractext/dev/extract
CONSUL_PERSISTENCE_KV_PREFIX=pdf-extractext/dev/persistence
CONSUL_AUDIT_KV_PREFIX=pdf-extractext/dev/auditlog

# ---- Traefik ----
LOG_LEVEL=info

# ---- Red ----
BACKEND_NETWORK=pdf-extractext_backend

# ---- Fallbacks de proceso (KV tiene prioridad en deploy) ----
# Tokens de servicio y parámetros; en deploy se cargan desde KV/compose.
AUDIT_LOG_API_TOKEN=local-audit-token
PERSISTENCE_API_TOKEN=local-persistence-token
PORT=8080
STOP_GRACE_PERIOD=45s
HTTP_TIMEOUT=35s
HEALTH_CHECK_TIMEOUT=2s
MAX_PDF_SIZE_BYTES=15MB
MAX_TEXT_BODY_BYTES=15MB
MAX_PDF_PAGES=1000
MAX_UPLOAD_MB=50
MAX_PAGES=1000
MAX_WORKERS=2
QUEUE_SIZE=56
QUEUE_MAX_MB=256
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=pdf_extractext
MONGO_DATABASE_AUDIT=pdf_extractext_audit
MONGO_TEXTS_COLLECTION=texts
MONGO_AUDIT_LOGS_COLLECTION=audit_logs
MONGO_TIMEOUT_MS=5000
PDF_OXIDE_LIB_PATH=/opt/pdf_oxide/libpdf_oxide.so
LOG_FORMAT=json
LOG_MAX_VALUE_LENGTH=256
LOG_MAX_STACK_LENGTH=4096
