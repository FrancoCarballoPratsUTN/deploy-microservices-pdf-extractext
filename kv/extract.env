# Seed de Consul KV para extract (prefijo ${CONSUL_EXTRACT_KV_PREFIX}).
# CONSUL_ENABLED es variable de entorno del proceso, no se escribe en KV.
# Se carga con `make kv-seed` usando docker exec y CONSUL_KV_SEED_TOKEN.

MAX_PAGES=1000
MAX_UPLOAD_MB=50
MAX_WORKERS=2
PORT=8080
QUEUE_MAX_MB=256
QUEUE_SIZE=56
READ_TIMEOUT=30
SHUTDOWN_TIMEOUT=35
WRITE_TIMEOUT=30
