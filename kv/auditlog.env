# Seed de Consul KV para auditlog (prefijo ${CONSUL_AUDIT_KV_PREFIX}).
# CONSUL_ENABLED es variable de entorno del proceso, no se escribe en KV.
# Los tokens de API NO se siembran: son secretos y viven en el entorno de
# compose (fallback) o en el KV ya cargado. Ver README §6.2.
# Se carga con `make kv-seed` usando docker exec y CONSUL_KV_SEED_TOKEN.

APP_NAME=Audit Log Microservice
DEFAULT_LIMIT=10
MAX_BODY_BYTES=1048576
MAX_DETAILS_BYTES=65536
MAX_LIMIT=100
MAX_SKIP=10000
MONGO_AUDIT_LOGS_COLLECTION=audit_logs
MONGO_DATABASE=pdf_extractext_audit
MONGO_TIMEOUT_MS=5000
MONGO_URI=mongodb://mongo:27017
RETENTION_DAYS=0
