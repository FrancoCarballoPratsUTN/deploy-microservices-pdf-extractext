# Seed de Consul KV para el orquestador (prefijo ${CONSUL_ORCHESTRATOR_KV_PREFIX}).
# CONSUL_ENABLED es variable de entorno del proceso, no se escribe en KV.
# Los tokens de API NO se siembran: son secretos y viven en el entorno de
# compose (fallback) o en el KV ya cargado. Ver README §6.2.
# Se carga con `make kv-seed` usando docker exec y CONSUL_KV_SEED_TOKEN.

EXTRACT_BASE_URL=http://traefik-internal:8443
PERSISTENCE_BASE_URL=http://traefik-internal:8443
AUDIT_LOG_BASE_URL=http://traefik-internal:8443
EXTRACT_HEALTH_URL=http://extract:8080/healthz
PERSISTENCE_HEALTH_URL=http://persistence:8000/readyz
AUDIT_LOG_HEALTH_URL=http://auditlog:8000/readyz
HEALTH_CHECK_TIMEOUT=2s
HTTP_TIMEOUT=35s
LOG_MAX_STACK_LENGTH=4096
LOG_MAX_VALUE_LENGTH=256
MAX_PDF_PAGES=1000
MAX_PDF_SIZE_BYTES=15MB
MAX_TEXT_BODY_BYTES=15MB
PORT=8080
SHUTDOWN_TIMEOUT=35s
